# ------------------------------------------------------------------ required
# Shared secret Nopxus sends as "Authorization: Bearer <key>" (>= 16 chars).
SCRAPER_API_KEY=change-me-to-a-long-random-string
# Where webhooks are POSTed (reachable from scraper-api over dokploy-network).
# `nopxus-app` = network alias you add to the Nopxus `app` service (see README); port 3001.
NOPXUS_WEBHOOK_URL=http://nopxus-app:3001/api/webhooks/scraper
# HMAC-SHA256 key used to sign webhooks (>= 16 chars). Nopxus verifies with it.
NOPXUS_WEBHOOK_SECRET=change-me-to-another-long-random-string
# docker-compose overrides this with redis://scraper-redis:6379
REDIS_URL=redis://localhost:6379

# Global concurrency of runs, per process. Browser runs have their own quota.
MAX_CONCURRENT_RUNS=4
MAX_CONCURRENT_BROWSER_RUNS=2

# Global ceilings for a run's `limits` (requests above them are clamped).
MAX_PAGES_PER_RUN=500
MAX_DEPTH=3
MAX_ITEMS_PER_RUN=10000
MAX_RUN_DURATION_SEC=900

# ------------------------------------------------------------------ optional
PORT=3000
# Max size of one HTTP response (bytes). Default 10 MiB.
MAX_RESPONSE_BYTES=10485760
# Hours that run state and items are kept after a run ends. Default 72.
RESULT_TTL_HOURS=72
# Identifiable User-Agent sent to scraped sites.
USER_AGENT=NopxusScraper/1.0 (+https://nopxus.com/bot)
# Extra blocked hosts (comma separated; "*.corp.example" wildcards allowed), on top of
# localhost, *.local, *.internal and the compose service names.
BLOCKED_HOSTS=

# Extras (defaults shown)
# MAX_CONCURRENCY=8                 # ceiling for limits.maxConcurrency
# MAX_CONCURRENCY_PER_DOMAIN=2
# MAX_ITEM_BYTES=65536
# LEASE_TTL_SEC=20                  # worker liveness lease used to detect restarts
# WEBHOOK_RETRY_BASE_MS=1000
# LOG_LEVEL=info
