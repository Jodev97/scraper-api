{
  "name": "scraper-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start:api": "node dist/api/main.js",
    "start:worker": "node dist/worker/main.js",
    "dev:api": "tsx watch --env-file=.env src/api/main.ts",
    "dev:worker": "tsx watch --env-file=.env src/worker/main.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "healthcheck:worker": "node dist/worker/healthcheck.js"
  },
  "dependencies": {
    "bullmq": "^6.7.3",
    "cheerio": "^1.2.0",
    "crawlee": "^3.18.2",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "jsdom": "^26.1.0",
    "pino": "^10.4.0",
    "playwright": "^1.65.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@11.1.3"
}
